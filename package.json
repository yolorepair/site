{
  "name": "yolorepair-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "npm run check:html && npm run check:links",
    "check:html": "html-validate dist",
    "check:links": "linkinator dist --recurse --check-css --check-fragments --skip '^https://' && linkinator '**/*.html' --server-root dist --recurse --check-fragments --skip '^https://'"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.6",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "astro": "^7.4.13"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "devDependencies": {
    "html-validate": "^11.21.1",
    "linkinator": "^8.1.0"
  }
}
