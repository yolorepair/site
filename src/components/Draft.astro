---
// Body of a page whose copy isn't written yet. Goes away page by page as the
// real content lands.
const { heading } = Astro.props;
---
<div>
  <h1>{heading}</h1>
  <p class="sub">ON THE BENCH · NOT DONE YET</p>
</div>
<p class="tag">This page isn't written yet.</p>
<p class="note">Got something broken? Email <a href="mailto:hello@yolorepair.com">hello@yolorepair.com</a> and say what it is and what it's doing.</p>
