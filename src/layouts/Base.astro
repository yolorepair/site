---
// Owns <head> for every page. Pages pass a title and a description; the
// canonical and the Open Graph URL come from the page's own path.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { draftPaths } from '../site.js';

const SITE_NAME = 'YOLO Electronics Repair';
const OG_ALT = 'YOLO Electronics Repair. You let the smoke out. We put it back in.';

// notFound: the 404 has no URL of its own, so no canonical and no share tags.
const { title, description, notFound = false } = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL('/og-image.png', Astro.site).href;
const noindex = notFound || draftPaths.includes(path);
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
{description && <meta name="description" content={description}>}
{noindex && <meta name="robots" content="noindex">}
{!notFound && <link rel="canonical" href={canonical}>}
<meta name="theme-color" content="#1E4D9B">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
{!notFound && (
  <Fragment>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content={SITE_NAME}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonical}>
    <meta property="og:image" content={ogImage}>
    <meta property="og:image:type" content="image/png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content={OG_ALT}>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={ogImage}>
    <meta name="twitter:image:alt" content={OG_ALT}>
  </Fragment>
)}
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<Header />
<main id="main">
  <slot />
</main>
<Footer />
</body>
</html>
