---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import '../styles/home.css';
---
<Base
  title="YOLO Electronics Repair · West Sacramento"
  description="Board-level electronics repair in West Sacramento. Laptops, GPUs, DJ gear, retro."
>
  <Mark label="YOLO Y-trace logo" />
  <div>
    <h1>YOLO Electronics Repair</h1>
    <p class="sub">BOARD-LEVEL REPAIR · WEST SAC · 916</p>
  </div>
  <p class="tag">You let the smoke out. We put it back in.</p>
  <ul class="chips">
    <li>LAPTOPS</li><li>GPUS</li><li>DJ GEAR</li><li>RETRO</li>
  </ul>
  <div class="contact">
    <b>J1</b><span><a href="mailto:hello@yolorepair.com">hello@yolorepair.com</a></span>
    <b>J2</b><span><a href="https://instagram.com/yolo.repair">@yolo.repair</a></span>
    <b>J3</b><span>West Sacramento · mail-in welcome</span>
  </div>
  <p class="note">Full site coming soon.</p>
</Base>
